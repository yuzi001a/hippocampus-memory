# v3 Memory Plugin — example env file (PUBLIC ALPHA)
#
# Copy to the absolute profile directory you chose (e.g.
# C:\Users\<you>\.v3-core\profiles\default\.env on Windows) and
# fill in. Every value below is a placeholder. See
# docs/CONFIGURATION.md § 2 for the engine's actual env-var support.
#
# WARNING:
#   * Do NOT commit a real .env with real secrets.
#   * The plugin manifest declares `requires_env: [V3CORE_PG_PASSWORD]`,
#     so PG_PASSWORD must be set for the plugin to load under Hermes.
#   * Use a local disposable PG for the public-alpha trial.
#   * The data root comes from the absolute top-level `basePath` key in
#     config.yaml. The engine does NOT expand `~` on Windows — write an
#     absolute path in config.yaml.

# Required by the plugin manifest (`requires_env`).
V3CORE_PG_PASSWORD=<local-only-password>

# Optional: explicit config-file path override.
# V3CORE_CONFIG=C:\Users\<you>\.v3-core\profiles\default\config.yaml

# Optional: explicit .env file path override used by the loader.
# V3CORE_DOTENV=C:\Users\<you>\.v3-core\profiles\default\.env
